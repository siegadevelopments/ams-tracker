# AMS Operations & SLA Management System — Production Configuration Template
# Copy to .env.production on production host

APP_NAME="AMS Operations & SLA Management System"
APP_VERSION=0.1.0
DEBUG=false
ENVIRONMENT=production

# Database Settings
POSTGRES_DB=ams_tracker
POSTGRES_USER=ams
POSTGRES_PASSWORD=GENERATE_STRONG_PASSWORD_HERE

DATABASE_URL=postgresql+asyncpg://ams:GENERATE_STRONG_PASSWORD_HERE@postgres:5432/ams_tracker

# Authentication (Generate with: openssl rand -hex 32)
SECRET_KEY=GENERATE_PRODUCTION_SECRET_KEY_HERE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=1440

# Timezone & CORS
DEFAULT_TIMEZONE=Asia/Manila
CORS_ORIGINS=https://yourdomain.com,http://localhost:3000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=120
