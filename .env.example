# AMS Operations & SLA Management System — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# ─── Application ────────────────────────────────────────────────────────
APP_NAME="AMS Operations & SLA Management System"
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# ─── Database ───────────────────────────────────────────────────────────
# PostgreSQL connection string (async driver)
DATABASE_URL=postgresql+asyncpg://ams:ams_dev_password@localhost:5432/ams_tracker

# ─── Authentication ────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE-ME-IN-PRODUCTION-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=1440

# ─── Timezone ───────────────────────────────────────────────────────────
DEFAULT_TIMEZONE=Asia/Manila

# ─── CORS ───────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ─── Rate Limiting ──────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60

# ─── Integrations (all optional) ───────────────────────────────────────
# SLACK_BOT_TOKEN=
# SLACK_WEBHOOK_URL=
# UVDESK_API_URL=
# UVDESK_API_KEY=
